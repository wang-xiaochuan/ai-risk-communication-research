{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "risk_benefit_score",
    "evaluation",
    "treatment",
    "frame_quadrant",
    "threat_evidence",
    "efficacy_evidence",
    "rationale",
    "confidence"
  ],
  "properties": {
    "risk_benefit_score": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "evaluation": {
      "enum": [
        "negative",
        "mixed",
        "positive",
        "none"
      ]
    },
    "treatment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present",
        "type",
        "receiver"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "type": {
          "enum": [
            "ethics-standards",
            "regulation",
            "safety-research",
            "funding",
            "other",
            null
          ]
        },
        "receiver": {
          "enum": [
            "academia",
            "industry",
            "political",
            "public",
            "other",
            null
          ]
        }
      }
    },
    "frame_quadrant": {
      "enum": [
        "high-threat",
        "balanced",
        "no-threat",
        "no-signal"
      ]
    },
    "threat_evidence": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60
      }
    },
    "efficacy_evidence": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 20
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
