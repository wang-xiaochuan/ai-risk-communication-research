{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "perceived_threat",
    "attribution_exit",
    "responsible_party",
    "actionable_exit",
    "evidence_quote",
    "rationale",
    "confidence"
  ],
  "properties": {
    "perceived_threat": {
      "enum": [
        "high",
        "moderate",
        "low",
        "none"
      ]
    },
    "attribution_exit": {
      "enum": [
        "R01",
        "R02",
        "R03",
        "R04",
        "R05",
        "R99"
      ]
    },
    "responsible_party": {
      "enum": [
        "developer",
        "government",
        "capital",
        "media",
        "public",
        null
      ]
    },
    "actionable_exit": {
      "type": "boolean"
    },
    "evidence_quote": {
      "type": "string",
      "minLength": 0,
      "maxLength": 60
    },
    "rationale": {
      "type": "string",
      "minLength": 10
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
